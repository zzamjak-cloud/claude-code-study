{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stylestudio-tauri",
  "version": "0.1.1",
  "identifier": "com.woody.stylestudio-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StyleStudio",
        "width": 1400,
        "height": 900,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2ODUwRDZEQzQxMzEyMkEKUldRcUVoUEViUTJGdHJFZmVXM1RqL2dZMFFXN3JrRzBGWG4wTXR3Z0VwUGpUc1dqNVdHME5VbVQK",
      "endpoints": [
        "https://github.com/zzamjak-cloud/claude-code-study/releases/download/stylestudio-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["stylestudio"]
      }
    }
  }
}
